{
  "slam_toolbox": {
    "scan_topic": "/realistic/scan/slam_hits",
    "use_scan_matching": true,
    "do_loop_closing": true,
    "distance_variance_penalty": 0.5,
    "minimum_travel_distance": 0.02,
    "minimum_time_interval": 0.25,
    "max_laser_range": 6.0,
    "base_frame": "base_footprint",
    "odom_frame": "odom",
    "__not_declared": []
  },
  "controller_server": {
    "FollowPath.plugin": "anc_nav2_sequential_controller::SequentialController",
    "FollowPath.linear_speed_mps": 0.08,
    "FollowPath.angular_speed_radps": 0.05,
    "FollowPath.path_heading_limit_rad": 0.12,
    "FollowPath.turn_stop_error_rad": 0.04,
    "FollowPath.settle_wall_s": 1.25,
    "FollowPath.max_angular_accel": null,
    "FollowPath.rotate_to_heading_min_angle": null,
    "FollowPath.rotate_to_heading_angular_vel": null,
    "FollowPath.lookahead_dist": 0.6,
    "FollowPath.min_lookahead_dist": null,
    "progress_checker.required_movement_angle": 0.4,
    "progress_checker.movement_time_allowance": 12.0,
    "goal_checker.xy_goal_tolerance": 0.15,
    "goal_checker.yaw_goal_tolerance": 0.08,
    "__not_declared": [
      "FollowPath.max_angular_accel",
      "FollowPath.rotate_to_heading_min_angle",
      "FollowPath.rotate_to_heading_angular_vel",
      "FollowPath.min_lookahead_dist"
    ]
  },
  "velocity_smoother": {
    "max_accel": [
      0.2,
      0.0,
      0.12
    ],
    "max_decel": [
      -0.25,
      0.0,
      -0.12
    ],
    "max_velocity": [
      0.12,
      0.0,
      0.1
    ],
    "deadband_velocity": [
      0.0,
      0.0,
      0.015
    ],
    "__not_declared": []
  },
  "anc_lidar_scan_conditioner": {
    "publish_slam_hits_only": true,
    "input_topic": "/realistic/scan/raw",
    "output_topic": "/realistic/scan",
    "range_min_m": 0.12,
    "range_max_m": 6.0,
    "__not_declared": []
  }
}
