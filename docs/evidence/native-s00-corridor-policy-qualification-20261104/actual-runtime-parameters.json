      0.12,
      0.0,
      0.1
    ],
    "deadband_velocity": [
      0.0,
      0.0,
      0.015
    ]
  },
  "anc_lidar_scan_conditioner": {
    "publish_slam_hits_only": true,
    "input_topic": "/realistic/scan/raw",
