    "FollowPath.rotate_to_heading_min_angle": 0.01,
    "FollowPath.rotate_to_heading_angular_vel": 0.1,
    "FollowPath.lookahead_dist": 0.35,
    "FollowPath.min_lookahead_dist": 0.35,
    "progress_checker.required_movement_angle": 0.5,
    "progress_checker.movement_time_allowance": 12.0,
    "goal_checker.xy_goal_tolerance": 0.15,
    "goal_checker.yaw_goal_tolerance": 0.08
