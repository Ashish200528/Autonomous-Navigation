<?xml version="1.0"?>
<!-- Gazebo window layout for the autodrive demo (passed to the Gazebo GUI as its gui-config file). -->
<window>
  <width>1900</width>
  <height>1010</height>
  <style
    material_theme="Dark"
    material_primary="LightBlue"
    material_accent="Cyan"
    toolbar_color_light="#f3f3f3"
    toolbar_text_color_light="#111111"
    toolbar_color_dark="#15171c"
    toolbar_text_color_dark="#e8eaed"
    plugin_toolbar_color_light="#bbdefb"
    plugin_toolbar_text_color_light="#111111"
    plugin_toolbar_color_dark="#1f232b"
    plugin_toolbar_text_color_dark="#e8eaed"/>
  <menus>
    <drawer default="false"/>
  </menus>
  <dialog_on_exit>false</dialog_on_exit>
</window>

<plugin filename="MinimalScene" name="3D View">
  <gz-gui>
    <title>3D View</title>
    <property type="bool" key="showTitleBar">false</property>
    <property type="string" key="state">docked</property>
  </gz-gui>
  <engine>ogre2</engine>
  <scene>scene</scene>
  <ambient_light>0.6 0.6 0.62</ambient_light>
  <background_color>0.55 0.72 0.93</background_color>
  <camera_pose>-7.5 -6.5 3.2 0 0.32 0.62</camera_pose>
  <camera_clip><near>0.05</near><far>120</far></camera_clip>
</plugin>
<plugin filename="GzSceneManager" name="Scene Manager">
  <gz-gui><property key="resizable" type="bool">false</property><property key="width" type="double">5</property><property key="height" type="double">5</property><property key="state" type="string">floating</property><property key="showTitleBar" type="bool">false</property></gz-gui>
</plugin>
<plugin filename="InteractiveViewControl" name="Interactive view control">
  <gz-gui><property key="resizable" type="bool">false</property><property key="width" type="double">5</property><property key="height" type="double">5</property><property key="state" type="string">floating</property><property key="showTitleBar" type="bool">false</property></gz-gui>
</plugin>
<plugin filename="CameraTracking" name="Camera Tracking">
  <gz-gui><property key="resizable" type="bool">false</property><property key="width" type="double">5</property><property key="height" type="double">5</property><property key="state" type="string">floating</property><property key="showTitleBar" type="bool">false</property></gz-gui>
  <!-- Chase camera. Default pgain 0.01 lags so much on curves that the car slides out of
       frame; 0.08 keeps it centred while still smoothing the motion. The target is set by
       the launch file after spawn (a follow_target here crashes the GUI before the robot exists). -->
  <follow_offset>-0.85 0 0.42</follow_offset>
  <follow_pgain>0.08</follow_pgain>
</plugin>
<plugin filename="MarkerManager" name="Marker manager">
  <gz-gui><property key="resizable" type="bool">false</property><property key="width" type="double">5</property><property key="height" type="double">5</property><property key="state" type="string">floating</property><property key="showTitleBar" type="bool">false</property></gz-gui>
</plugin>
<plugin filename="WorldControl" name="World control">
  <gz-gui>
    <title>World control</title>
    <property type="bool" key="showTitleBar">false</property>
    <property type="bool" key="resizable">false</property>
    <property type="double" key="height">72</property>
    <property type="double" key="width">121</property>
    <property type="double" key="z">1</property>
    <property type="string" key="state">floating</property>
    <anchors target="3D View"><line own="left" target="left"/><line own="bottom" target="bottom"/></anchors>
  </gz-gui>
  <play_pause>true</play_pause>
  <step>false</step>
  <start_paused>false</start_paused>
</plugin>
<plugin filename="WorldStats" name="World stats">
  <gz-gui>
    <title>World stats</title>
    <property type="bool" key="showTitleBar">false</property>
    <property type="bool" key="resizable">false</property>
    <property type="double" key="height">110</property>
    <property type="double" key="width">290</property>
    <property type="double" key="z">1</property>
    <property type="string" key="state">floating</property>
    <anchors target="3D View"><line own="right" target="right"/><line own="bottom" target="bottom"/></anchors>
  </gz-gui>
  <sim_time>true</sim_time>
  <real_time>false</real_time>
  <real_time_factor>true</real_time_factor>
  <iterations>false</iterations>
</plugin>
<plugin filename="ImageDisplay" name="Car HUD">
  <gz-gui>
    <title>Car camera + decisions</title>
    <property type="bool" key="showTitleBar">false</property>
    <property type="double" key="width">480</property>
    <property type="double" key="height">360</property>
    <property type="double" key="z">2</property>
    <property type="string" key="state">floating</property>
    <!-- Top-left: the track only turns left, so the car drifts to the right of the view. -->
    <anchors target="3D View"><line own="left" target="left"/><line own="top" target="top"/></anchors>
  </gz-gui>
  <topic>/autodrive/hud</topic>
  <topic_picker>false</topic_picker>
</plugin>
